# Copy to .env for local development. In the cloud, set these in the platform's
# secret store instead. Never commit .env.

# --- required ---
ANTHROPIC_API_KEY=

# Copy the exact cluster URL from the Qdrant Cloud dashboard (https://...).
QDRANT_URL=https://<cluster-id>.<region>.<cloud>.cloud.qdrant.io
QDRANT_API_KEY=

# --- optional (defaults live in src/beamter/config.py) ---
# SERVICE_API_KEY=          # if set, API clients must send it in the X-API-Key header
# BEAMTER_COLLECTION=beamter_docs
# BEAMTER_LLM_MODEL=claude-haiku-4-5
# BEAMTER_RETRIEVAL_MODE=hybrid_rerank
# BEAMTER_MIN_RERANK_SCORE=-2.5   # best rerank score below this -> "not covered", no LLM call (above it the model decides)
# BEAMTER_REWRITE_QUERIES=1       # 0 turns off the LLM query-rewriting step
# BEAMTER_MAX_CONCURRENCY=4       # questions processed at once per instance
# BEAMTER_RATE_LIMIT_PER_MIN=30   # per client; 0 = off
# BEAMTER_RELOAD_CHECK_S=60       # look for a new index version this often; 0 = never
# BEAMTER_CORS_ORIGINS=           # e.g. https://my-frontend.example.com (comma-separated)
